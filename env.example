# PINGO environment
# Copy the values you need into .env.local for development and into
# Vercel → Project → Settings → Environment Variables for deployment.
# Never commit real secrets.

# ---------------------------------------------------------------------------
# Client (safe to expose; bundled into the browser)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the anon/publishable key, never the service_role key.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional development-only fallback. Do NOT put permanent TURN secrets here.
# Production calls use the server-minted credentials from /api/turn instead.
# VITE_TURN_URL=turn:global.turn.twilio.com:3478?transport=udp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Server only (Vercel functions; never prefix with VITE_)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Privileged server operations only. Never prefix this with VITE_ and never
# send it to the browser. The current app uses user-JWT RLS for normal work.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Optional Upstash rate limiting (server only). PostgreSQL remains the source
# of truth; Redis holds short-lived counters only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Twilio Network Traversal Service — https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_twilio_api_secret
# Optional: lifetime of minted TURN credentials in seconds (default 3600).
TWILIO_TURN_TTL=3600

# ---------------------------------------------------------------------------
# LiveKit (future SFU / group calling — not used by the current 1:1 client)
# Keep these server-side and mint participant tokens from a function.
# ---------------------------------------------------------------------------
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
